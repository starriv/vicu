        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is your largest position at %2$@ weight, giving a diversification score of %3$d/100. Trimming roughly %4$@ would align it closer to a 25%% single-position ceiling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是你的第一大重仓（占比 %2$@），当前分散度评分 %3$d/100。若减仓约 %4$@，可将其权重收敛至 25%% 左右的稳健单票上限。"
