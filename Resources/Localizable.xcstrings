    "home_ai.copilot.reply.health_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your composite Health Score is %1$d/100 — built from Diversification (%2$d), Liquidity (%3$d), and Momentum (%4$d). Improving the lowest sub-score yields the fastest risk-adjusted gain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的综合组合健康度为 %1$d/100，由分散度（%2$d）、流动性（%3$d）和动量表现（%4$d）加权得出。优先补齐最低分项可最快改善风险收益比。"
          }
        }
      }
    },
    "home_ai.copilot.reply.liquidity_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buying power is %1$@, cash is %2$@, and gross leverage is %3$@ (Liquidity score: %4$d/100). Keep leverage near 1.0x and positive cash buffer to avoid margin squeeze."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前购买力为 %1$@，现金余额 %2$@，总杠杆 %3$@（流动性评分 %4$d/100）。建议将杠杆维持在 1.0x 附近并保留正向现金缓冲，以防范波动期保证金压力。"
          }
        }
      }
    },
    "home_ai.copilot.reply.orders_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of the %2$d most recent orders loaded, %1$d are open. Review their prices against your target weights."
