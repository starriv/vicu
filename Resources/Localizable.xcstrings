          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 目前占持仓总敞口的 %2$@（市值 %3$@），累计浮动盈亏 %4$@（%5$@）。点击下方可直接进入持仓详情复核或调整仓位。"
